# Clé API Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Mode simulation : tant que cette valeur n'est pas "false", rien n'est réellement publié.
SOCIAL_DRY_RUN=true

# Facebook (Page) — jeton de Page avec pages_manage_posts
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# Instagram (compte professionnel lié à la Page) — instagram_content_publish
INSTAGRAM_USER_ID=
INSTAGRAM_TOKEN=

# LinkedIn (page entreprise) — w_organization_social ; ex. urn:li:organization:123456
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN=

# X — jeton OAuth 2.0 utilisateur avec tweet.write
X_USER_ACCESS_TOKEN=
